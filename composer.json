{
    "name": "segara/segara",
    "description": "A small, semantic PHP CMS with SQLite storage.",
    "type": "project",
    "license": "BSD-2-Clause",
    "require": {
        "php": ">=8.4.1",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-xml": "*",
        "ext-xmlreader": "*",
        "ext-xmlwriter": "*",
        "ext-zip": "*",
        "erusev/parsedown": ">=1.8.0 <1.8.0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "13.1.6",
        "phpstan/phpstan": "2.3.2",
        "vimeo/psalm": "6.20.1"
    },
    "autoload": {
        "psr-4": {
            "Segara\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true
    }
}
