#!/usr/bin/env php
<?php

declare(strict_types=1);

use Segara\Maintenance\Backup;

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    echo "Not Found\n";
    exit(1);
}

$projectRoot = dirname(__DIR__);
require $projectRoot . '/vendor/autoload.php';

$options = getopt('', ['file:', 'target:', 'confirm', 'help']);
if (isset($options['help'])) {
    echo "Usage: php bin/restore --file=PATH --target=DIR --confirm\n";
    echo "Restore a backup into an empty target directory. Requires --confirm.\n";
    exit(0);
}
if ($options === false) {
    fwrite(STDERR, "ERROR: Invalid command options. Use --help for usage.\n");
    exit(1);
}
if (!isset($options['confirm'])) {
    fwrite(STDERR, "ERROR: restore requires --confirm. Refusing to restore without confirmation.\n");
    exit(1);
}

$file = $options['file'] ?? null;
$target = $options['target'] ?? null;
if (!is_string($file) || !is_string($target)) {
    fwrite(STDERR, "ERROR: --file and --target are required.\n");
    exit(1);
}

try {
    (new Backup($projectRoot . '/store'))->restore($file, $target);
} catch (Throwable $exception) {
    fwrite(STDERR, 'ERROR: ' . $exception->getMessage() . "\n");
    exit(1);
}

echo "OK: restored to {$target}\n";
exit(0);
