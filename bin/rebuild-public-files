#!/usr/bin/env php
<?php

declare(strict_types=1);

use Segara\Config;
use Segara\Maintenance\PublicFiles;
use Segara\Pages\PageRepository;
use Segara\Storage\Database;

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    echo "Not Found\n";
    exit(1);
}

$projectRoot = dirname(__DIR__);
require $projectRoot . '/vendor/autoload.php';

$options = getopt('', ['public:', 'help']);
if (isset($options['help'])) {
    echo "Usage: php bin/rebuild-public-files [--public=PATH]\n";
    echo "Regenerate sitemap.xml, robots.txt, and llms.txt from published pages.\n";
    exit(0);
}
if ($options === false) {
    fwrite(STDERR, "ERROR: Invalid command options. Use --help for usage.\n");
    exit(1);
}

$publicRoot = $options['public'] ?? $projectRoot . '/public';
if (!is_string($publicRoot)) {
    fwrite(STDERR, "ERROR: --public requires one value.\n");
    exit(1);
}

try {
    $config = Config::load($projectRoot . '/settings/config.php');
    $pdo = Database::connect($projectRoot . '/store/segara.sqlite');
    $written = (new PublicFiles($config, new PageRepository($pdo), $publicRoot))->rebuild();
} catch (Throwable $exception) {
    fwrite(STDERR, 'ERROR: ' . $exception->getMessage() . "\n");
    exit(1);
}

echo 'OK: public metadata rebuilt (' . implode(', ', $written) . ")\n";
exit(0);
