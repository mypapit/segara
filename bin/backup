#!/usr/bin/env php
<?php

declare(strict_types=1);

use Segara\Maintenance\Backup;
use Segara\Storage\Database;

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    echo "Not Found\n";
    exit(1);
}

$projectRoot = dirname(__DIR__);
require $projectRoot . '/vendor/autoload.php';

$options = getopt('', ['help']);
if (isset($options['help'])) {
    echo "Usage: php bin/backup\n";
    echo "Create a consistent ZIP backup of the database and uploads under store/backups/.\n";
    exit(0);
}
if ($options === false) {
    fwrite(STDERR, "ERROR: Invalid command options. Use --help for usage.\n");
    exit(1);
}

try {
    $pdo = Database::connect($projectRoot . '/store/segara.sqlite');
    $result = (new Backup($projectRoot . '/store'))->create($pdo, $projectRoot . '/uploads');
} catch (Throwable $exception) {
    fwrite(STDERR, 'ERROR: ' . $exception->getMessage() . "\n");
    exit(1);
}

echo 'OK: backup written to ' . $result['zip'] . ' (' . $result['bytes'] . ' bytes, ' . count($result['files']) . " files)\n";
exit(0);
