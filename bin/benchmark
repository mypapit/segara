#!/usr/bin/env php
<?php

declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    echo "Not Found\n";
    exit(1);
}

$options = getopt('', ['url:', 'requests:', 'help']);
if (isset($options['help'])) {
    echo "Usage: php bin/benchmark --url=URL [--requests=N]\n";
    echo "Measure median requests per second against a local endpoint. Does not enable caching.\n";
    exit(0);
}
if ($options === false) {
    fwrite(STDERR, "ERROR: Invalid command options. Use --help for usage.\n");
    exit(1);
}

$url = $options['url'] ?? null;
$requests = $options['requests'] ?? 100;
if (!is_string($url) || $url === '') {
    fwrite(STDERR, "ERROR: --url is required.\n");
    exit(1);
}
if (!is_string($requests) && !is_int($requests)) {
    fwrite(STDERR, "ERROR: --requests must be an integer.\n");
    exit(1);
}
$count = (int) $requests;
if ($count < 1 || $count > 10000) {
    fwrite(STDERR, "ERROR: --requests must be between 1 and 10000.\n");
    exit(1);
}

$durations = [];
$context = stream_context_create(['http' => ['timeout' => 5, 'ignore_errors' => true]]);
for ($i = 0; $i < $count; $i++) {
    $start = hrtime(true);
    file_get_contents($url, false, $context);
    $durations[] = (hrtime(true) - $start) / 1e9;
}
sort($durations);
$median = $durations[intdiv(count($durations), 2)];
$perSecond = $median > 0 ? round(1 / $median, 1) : 0.0;
echo 'OK: ' . $count . ' requests, median ' . number_format($median * 1000, 2) . ' ms (' . $perSecond . " req/s)\n";
exit(0);
