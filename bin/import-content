#!/usr/bin/env php
<?php

declare(strict_types=1);

use Segara\Pages\PageRepository;
use Segara\Storage\Database;
use Segara\Transfer\WxrImport;

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    echo "Not Found\n";
    exit(1);
}

$projectRoot = dirname(__DIR__);
require $projectRoot . '/vendor/autoload.php';

$options = getopt('', ['file:', 'help']);
if (isset($options['help'])) {
    echo "Usage: php bin/import-content --file=PATH\n";
    echo "Import a WXR 1.2 XML file into the page store.\n";
    exit(0);
}
if ($options === false) {
    fwrite(STDERR, "ERROR: Invalid command options. Use --help for usage.\n");
    exit(1);
}

$file = $options['file'] ?? null;
if (!is_string($file)) {
    fwrite(STDERR, "ERROR: --file is required.\n");
    exit(1);
}
if (!is_file($file)) {
    fwrite(STDERR, "ERROR: Import file not found.\n");
    exit(1);
}

try {
    $pdo = Database::connect($projectRoot . '/store/segara.sqlite');
    $xml = file_get_contents($file);
    if ($xml === false) {
        throw new RuntimeException('Could not read import file.');
    }
    $result = (new WxrImport(new PageRepository($pdo)))->import($xml);
} catch (Throwable $exception) {
    fwrite(STDERR, 'ERROR: ' . $exception->getMessage() . "\n");
    exit(1);
}

$summary = 'OK: imported ' . $result['imported'] . ' page(s)';
if ($result['conflicts'] !== []) {
    $summary .= ', conflicts: ' . implode(', ', $result['conflicts']);
}
if ($result['errors'] !== []) {
    $summary .= ', errors: ' . count($result['errors']);
}
echo $summary . "\n";
exit(0);
