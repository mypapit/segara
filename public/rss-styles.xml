<?xml version="1.0" encoding="UTF-8"?>
<!--
    Browser view for /rss.xml. Feed readers ignore this entirely and read the
    XML; only a browser applies it. XSLT 1.0, because that is all browsers ship.
    The description is printed as text, never injected as markup.
-->
<xsl:stylesheet version="1.0"
                xmlns:xsl="http://www.w3.org/1999/XSL/Transform">

    <xsl:output method="html" encoding="UTF-8" indent="yes"/>

    <xsl:template match="/">
        <html lang="en">
            <head>
                <title><xsl:value-of select="rss/channel/title"/>: feed</title>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <link rel="stylesheet" href="assets/xml.css"/>
            </head>
            <body>
                <main class="doc">
                    <header class="doc-head">
                        <p class="doc-kicker">RSS feed</p>
                        <h1><xsl:value-of select="rss/channel/title"/></h1>
                        <p class="doc-meta"><xsl:value-of select="count(rss/channel/item)"/><xsl:choose>
                            <xsl:when test="count(rss/channel/item) = 1"><xsl:text> item, newest first</xsl:text></xsl:when>
                            <xsl:otherwise><xsl:text> items, newest first</xsl:text></xsl:otherwise>
                        </xsl:choose></p>
                        <p class="doc-lede">
                            <xsl:value-of select="rss/channel/description"/>
                            The raw feed is <a href="rss.xml">rss.xml</a>.
                        </p>
                    </header>

                    <ol class="doc-list">
                        <xsl:for-each select="rss/channel/item">
                            <li class="doc-row">
                                <a class="doc-link" href="{link}"><xsl:value-of select="title"/></a>
                                <xsl:if test="pubDate">
                                    <time class="doc-date" datetime="{pubDate}"><xsl:value-of select="pubDate"/></time>
                                </xsl:if>
                            </li>
                        </xsl:for-each>
                    </ol>

                    <footer class="doc-foot">Generated by Segara.</footer>
                </main>
            </body>
        </html>
    </xsl:template>
</xsl:stylesheet>
