<?xml version="1.0" encoding="UTF-8"?>
<!--
    Browser view for /sitemap.xml. The XML is untouched for crawlers: this is a
    presentation layer only, declared by the xml-stylesheet instruction in the
    sitemap itself. XSLT 1.0, because that is all browsers ship.
-->
<xsl:stylesheet version="1.0"
                xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
                xmlns:sm="http://www.sitemaps.org/schemas/sitemap/0.9"
                exclude-result-prefixes="sm">

    <xsl:output method="html" encoding="UTF-8" indent="yes"/>

    <xsl:template match="/">
        <html lang="en">
            <head>
                <title>Sitemap</title>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <link rel="stylesheet" href="assets/xml.css"/>
            </head>
            <body>
                <main class="doc">
                    <header class="doc-head">
                        <p class="doc-kicker">Sitemap</p>
                        <h1>Every published page</h1>
                        <p class="doc-meta">
                            <xsl:value-of select="count(sm:urlset/sm:url)"/>
                            <xsl:choose>
                                <xsl:when test="count(sm:urlset/sm:url) = 1"> URL</xsl:when>
                                <xsl:otherwise> URLs</xsl:otherwise>
                            </xsl:choose>
                        </p>
                        <p class="doc-lede">
                            For crawlers. The machine-readable original is
                            <a href="sitemap.xml">sitemap.xml</a>.
                        </p>
                    </header>

                    <ol class="doc-list">
                        <xsl:for-each select="sm:urlset/sm:url">
                            <li class="doc-row">
                                <a class="doc-link" href="{sm:loc}"><xsl:value-of select="sm:loc"/></a>
                                <xsl:if test="sm:lastmod">
                                    <time class="doc-date" datetime="{sm:lastmod}"><xsl:value-of select="sm:lastmod"/></time>
                                </xsl:if>
                            </li>
                        </xsl:for-each>
                    </ol>

                    <footer class="doc-foot">Generated by Segara.</footer>
                </main>
            </body>
        </html>
    </xsl:template>
</xsl:stylesheet>
