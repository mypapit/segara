# Segara CMS - data-directory .htaccess
# Installed as store/.htaccess and uploads/.htaccess by deploy/install.sh.
# Apache only reads it when this directory is inside DocumentRoot, i.e. when the
# DocumentRoot is wrong. It denies the directory outright, whatever the file names.
# It restricts HTTP requests only: PHP reading a file from uploads/ is unaffected.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule mod_access_compat.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes
